APP_NAME=CiviX Backend
APP_ENV=development
DEBUG=true

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=civix

JWT_SECRET_KEY=replace_with_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=20160

GEMINI_API_KEY=replace_with_your_gemini_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL_FALLBACKS=gemini-1.5-flash,gemini-1.5-flash-latest
GEMINI_QUOTA_COOLDOWN_SECONDS=600

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
WHISPER_MODEL_NAME=base

CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8080", "http://127.0.0.1:3000", "http://127.0.0.1:5173", "http://127.0.0.1:8080"]
RATE_LIMIT=100/minute

DEMO_ACCOUNT_ENABLED=true
DEMO_ACCOUNT_NAME=Demo User
DEMO_ACCOUNT_EMAIL=demo@civixapp.com
DEMO_ACCOUNT_PASSWORD=Demo@12345
DEMO_ACCOUNT_AGE=24
DEMO_ACCOUNT_GENDER=Female
DEMO_ACCOUNT_OCCUPATION=Student
DEMO_ACCOUNT_INCOME=200000
DEMO_ACCOUNT_STATE=Maharashtra
DEMO_ACCOUNT_DISTRICT=Pune
DEMO_ACCOUNT_EDUCATION_LEVEL=Graduate
DEMO_ACCOUNT_SOCIAL_CATEGORY=OBC
DEMO_ACCOUNT_RESIDENCE_TYPE=Urban
DEMO_ACCOUNT_MARITAL_STATUS=Single
DEMO_ACCOUNT_DISABILITY_STATUS=no
DEMO_ACCOUNT_MINORITY_STATUS=no
